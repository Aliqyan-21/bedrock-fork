// output: 1111111

func add(a: i64, b: i64) -> i64
  return a + b;
end

func main() -> i64
  var total: i64 = 0;

  // i32 to i64 (binary op)
  var a: i64 = 99;
  var b: i32 = 1000;
  if a + b == 1099
    total = total + 1;
  end

  // u32 to u64 (binary op)
  var ua: u64 = 10;
  var ub: u32 = 5;
  if ua + ub == 15
    total = total + 10;
  end

  // i32 to f64 (binary op)
  var fa: f64 = 2.5;
  var fb: i32 = 4;
  if fa + fb == 6.5
    total = total + 100;
  end

  // i32 to i64 (var decl)
  var x: i32 = 5;
  var y: i64 = x;
  if y == 5
    total = total + 1000;
  end

  // i32 to i64 (plain assignment)
  var y2: i64 = 0;
  var x2: i32 = 42;
  y2 = x2;
  if y2 == 42
    total = total + 10000;
  end

  //  i32 to i64 (compound assignment)
  var y3: i64 = 100;
  var x3: i32 = 5;
  y3 += x3;
  if y3 == 105
    total = total + 100000;
  end

  // i32 to i64 param (call arg)
  var x4: i32 = 7;
  var r7: i64 = add(100, x4);
  if r7 == 107
    total = total + 1000000;
  end

  return total;
end
