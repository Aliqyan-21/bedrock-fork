extern proc printf(...);

func partition(arr: []i32, first: i32, last: i32) -> i32
  var pivot: i32 = undefined;

  var idx: i32 = undefined; var small_idx: i32 = undefined;

  pivot = arr[first];
  small_idx = first;

  for idx in first + 1..=last
    if (arr[idx] < pivot)
      small_idx+=1;
      var tmp = arr[small_idx];
      arr[small_idx] = arr[idx];
      arr[idx] = tmp;
    end
  end

  var tmp = arr[first];
  arr[first] = arr[small_idx];
  arr[small_idx] = tmp;

  return small_idx;
end

proc quicksort(arr: []i32, first: i32, last: i32)
  var pivot_loc: i32 = undefined;
  if (first < last)
    pivot_loc = partition(arr, first, last);
    quicksort(arr, first, pivot_loc - 1);
    quicksort(arr, pivot_loc + 1, last);
  end
end

func main() -> i32
  var arr = [1, 21, 3, 56, 32, 12, 2, 0, 1, 3];

  printf("before sorting: \n");
  for i in arr
    printf("%d  ", i);
  end
  printf("\n");

  printf("after sorting: \n");
  quicksort(arr, 0, 9);
  for i in arr
    printf("%d  ", i);
  end
  printf("\n");

  return 0;
end
